{
  "name": "gallery-portfolio-static",
  "version": "1.0.0",
  "description": "个人摄影作品展示网站，支持Cloudflare Pages部署",
  "main": "index.html",
  "type": "module",
  "scripts": {
    "build": "npm run check",
    "check": "node scripts/check.js",
    "test": "node --test",
    "verify": "npm run check && npm test",
    "dev": "wrangler pages dev .",
    "deploy": "wrangler pages deploy .",
    "serve": "serve .",
    "generate-index": "node generate-gallery-index-imgbed.js",
    "imgbed:generate-index": "node generate-gallery-index-imgbed.js"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "npm@11.16.0",
  "keywords": [
    "gallery",
    "portfolio",
    "photography",
    "static",
    "cloudflare-pages"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "serve": "^14.2.1",
    "wrangler": "4.129.1"
  },
  "dependencies": {
    "dotenv": "^17.2.1"
  }
}
